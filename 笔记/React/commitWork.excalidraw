      "isDeleted": false,
      "boundElements": null,
      "updated": 1780748954026,
      "link": null,
      "locked": false,
      "text": "function commitWork(fiber) {\n    if (!fiber) {\n        return\n    }\n\n    const domParent = fiber.parent.dom\n    domParent.appendChild(fiber.dom)\n    commitWork(fiber.child)\n    commitWork(fiber.sibling)\n}",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function commitWork(fiber) {\n    if (!fiber) {\n        return\n    }\n\n    const domParent = fiber.parent.dom\n    domParent.appendChild(fiber.dom)\n    commitWork(fiber.child)\n    commitWork(fiber.sibling)\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
