{
	"nodes":[
		{"id":"08ebd09ebed9b2b5","type":"group","x":-1600,"y":0,"width":1435,"height":986,"label":"添加搜索功能"},
		{"id":"495e376cd5d1c752","x":-1600,"y":1040,"width":1435,"height":740,"type":"group","label":"使用 URL 参数实现分页功能"},
		{"id":"8519b36aa9c3a6ff","type":"text","text":"const params = new URLSearchParams(searchParams)","x":-705,"y":330,"width":380,"height":70},
		{"id":"7cdb8aff866140bc","type":"text","text":"调用params的set方法，将Input值设置为查询参数","x":-705,"y":500,"width":440,"height":60},
		{"id":"57a7dd0aa4b33b33","type":"text","text":"        defaultValue={searchParams.get('query')?.toString()}","x":-705,"y":854,"width":520,"height":52},
